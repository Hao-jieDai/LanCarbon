{
  "name": "lancarbon",
  "version": "2.5.1",
  "description": "A desktop app for writing, reading and building a personal knowledge library",
  "main": "dist-electron/electron/main.js",
  "author": "LanCarbon",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/prepare-pdf.cjs && node scripts/prepare-ocr.cjs && concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "build": "node scripts/prepare-pdf.cjs && node scripts/prepare-ocr.cjs && npm run typecheck && vite build && tsc -p tsconfig.electron.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rag": "vitest run tests/rag-clean-input.test.ts tests/rag-relation-boundaries.test.ts tests/rag-numeric-binding.test.ts tests/rag-generation-baseline.test.ts tests/rag-context-select.test.ts tests/rag-evidence-first.test.ts tests/rag-regressions.test.ts tests/chat-research.test.ts tests/chat-evidence.test.ts tests/chat-policy.test.ts tests/chat-quality.test.ts tests/chat-repair.test.ts tests/chat-grounding.test.ts tests/retrieval.test.ts tests/chat-completeness.test.ts tests/chat-formal-evidence.test.ts tests/storage.test.ts tests/paperqa-grounding.test.ts tests/ai-chat-files.test.ts tests/chat-quantities.test.ts tests/chat-calculations.test.ts",
    "test:e2e": "npm run build && playwright test",
    "clean:installers": "node scripts/clean-installers.cjs",
    "dist": "npm run build && node scripts/build-installer.cjs",
    "setup:paperqa": "node scripts/setup-paperqa.cjs",
    "dev:paperqa": "node scripts/dev-paperqa.cjs",
    "prepare:paperqa": "node scripts/prepare-paperqa-runtime.cjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.10",
    "@lezer/highlight": "^1.2.3",
    "@xmldom/xmldom": "0.8.15",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.14",
    "katex": "^0.18.5",
    "mdast-util-to-hast": "^12.3.0",
    "myst-common": "^1.10.0",
    "myst-parser": "^1.7.3",
    "myst-to-html": "^1.7.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vfile": "^5.3.7",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^44.1.0",
    "electron-builder": "^26.0.12",
    "jsdom": "^26.1.0",
    "pdfjs-dist": "6.4.299",
    "tesseract.js": "7.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "cn.lancarbon.desktop",
    "productName": "LanCarbon",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/book-theme-runtime.zip",
        "to": "book-theme-runtime.zip"
      },
      {
        "from": "resources/starter-content",
        "to": "starter-content"
      },
      {
        "from": "build/paperqa-runtime",
        "to": "paperqa-runtime",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "LanCarbon-${version}-${arch}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "include": "build/installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LanCarbon"
    }
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": true,
    "esbuild": true
  },
  "overrides": {
    "markdown-it": "15.0.1",
    "linkify-it": "6.1.0"
  }
}
